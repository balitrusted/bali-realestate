# Admin Panel Password (required for /admin)
# Use a long, random password in production (e.g. 16+ chars, letters + numbers + symbols).
# Generate one: https://passwordsgenerator.net/ or: openssl rand -base64 24
ADMIN_PASSWORD=adminRangerSTR*0709

# Base URL for email notifications
# Set this to your production URL when deploying
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google Analytics 4 (optional)
# Create a GA4 property at https://analytics.google.com/ and paste the Measurement ID (G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console verification (optional)
# In Search Console, choose HTML tag verification and paste only the content value.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vercel Blob Storage (for production - images)
# BLOB_READ_WRITE_TOKEN: from Vercel Storage → your Blob store (for uploads)
# NEXT_PUBLIC_BLOB_STORE_URL: base URL so the site loads images directly (no API). Example:
#   https://xxxxx.public.blob.vercel-storage.com  (from Storage → open any blob → copy domain)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxx
# NEXT_PUBLIC_BLOB_STORE_URL=https://xxxxx.public.blob.vercel-storage.com

# Supabase (staged rollout for high-write entities)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=eyJ... (for future client-side usage)
# SUPABASE_SERVICE_ROLE_KEY=eyJ... (server only, never expose to browser)
# SEARCH_QUERY_LOGS_ROLLOUT_MODE=blob
# REQUESTS_ROLLOUT_MODE=blob
# COMMENTS_ROLLOUT_MODE=blob
# NOTIFY_REQUESTS_ROLLOUT_MODE=blob

# Email (Resend) – notifications for requests, comments, notify-me
# 1. Sign up at https://resend.com → API Keys → Create → copy key
# 2. Add RESEND_API_KEY and ADMIN_EMAIL in Vercel Environment Variables
# RESEND_API_KEY=re_xxxxxxxxxxxxx
# ADMIN_EMAIL=your@email.com
# Optional: custom "from" (after verifying domain in Resend): EMAIL_FROM=Balitrusted <notify@balitrusted.com>
#
# If admin sees new rows but no inbox mail: check Vercel → Deployment → Logs for
# [email] sendToAdmin failed / RESEND_API_KEY not set / ADMIN_EMAIL not set.
# In Resend: API key valid, domain verified for EMAIL_FROM, and (for trial) recipient rules.
